    {
      "id": "xXHVo7a4qnSkHPG0ekipV",
      "type": "text",
      "x": 955.7701828671106,
      "y": 4678.757317193657,
      "width": 568.2609041224724,
      "height": 59.277857928161225,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
