      "seed": 616024058,
      "version": 140,
      "versionNonce": 993130662,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785577144307,
      "link": null,
      "locked": false,
      "text": "SPIFFE is the rulebook for how software should\n prove its own identity.",
      "fontSize": 23.711143171264485,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SPIFFE is the rulebook for how software should\n prove its own identity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nlaTv4whS1Bcv-f58Zsu9",
      "type": "text",
      "x": 955.7691617437679,
      "y": 4799.053357336444,
      "width": 570.044474655616,
      "height": 79.63892896408106,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 825709434,
      "version": 158,
      "versionNonce": 1678234426,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785577142045,
      "link": null,
      "locked": false,
      "text": "SPIRE is the real system that actually enforces that \nrulebook — issuing, verifying, and auto-rotating \nshort-lived identities for our AI system",
      "fontSize": 21.237047723754948,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SPIRE is the real system that actually enforces that \nrulebook — issuing, verifying, and auto-rotating \nshort-lived identities for our AI system",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sAsLW_n2rTRl9bAHVYgOb",
      "type": "text",
      "x": 854.1493448099149,
      "y": 4990.191704921861,
      "width": 821.9822381600884,
      "height": 79.14842030602358,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 10553530,
      "version": 228,
      "versionNonce": 1442158310,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785577139488,
      "link": null,
      "locked": false,
      "text": "SPIRE gives an identity to that whole running program — the Docker container\nthat has our Python code, our governance checks, AND the code that calls the\nLLM, all bundled together as one workload.",
      "fontSize": 21.10624541493961,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SPIRE gives an identity to that whole running program — the Docker container that has our Python code, our governance checks, AND the code that calls the LLM, all bundled together as one workload.",
      "autoResize": false,
      "lineHeight": 1.25
    },
